# DA8N public site — environment template.
# Copy to .env.local for development. Do not commit secrets.
#
# This app makes NO API calls and holds NO credentials. Every variable here is
# about identity and indexing, not access.

# Canonical public origin for THIS deployment, no trailing slash.
# MUST be set per environment. An unset value on a preview deployment emits
# production canonicals from a preview URL, which is a live indexation hazard.
#   production: https://www.da8n.com
#   preview:    https://<the-preview-url>
#   local:      http://localhost:3006
NEXT_PUBLIC_SITE_URL=http://localhost:3006

# Site-wide crawl switch. Anything other than exactly "true" serves
# `Disallow: /` for every user agent. Set "true" on production ONLY, and only
# once there is content worth indexing.
DA8N_SEO_ENABLED=false

# Where member CTAs (join, sign in) point while the member application still
# lives in the Date9ja app. See README "The boundary".
NEXT_PUBLIC_APP_ORIGIN=https://www.date9ja.love
